{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "justgame",
  "main": "worker.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.txt"],
      "fallthrough": true
    }
  ]
}
